# Copy to .env and fill in. .env is gitignored — never commit it.

# --- where data lives (relative paths are inside the repo; all gitignored) ---
KB_ARCHIVE_DIR=archive
KB_INDEX_DIR=index
KB_LOG_DIR=logs
KB_OUTBOX_DIR=outbox
KB_LOOKBACK_DAYS=3                       # how far back the first ingest reaches
KB_USER_AGENT=kbase-template/0.1 (personal research; you@example.com)

# --- model calls (Claude Code CLI) ---
# CLAUDE_BIN=/path/to/claude             # only if `claude` isn't on PATH
# CLAUDE_CODE_OAUTH_TOKEN=               # from `claude setup-token`; needed for unattended (cron/launchd) runs

# --- email out: file (default, writes outbox/*.html) or smtp ---
EMAIL_MODE=file
EMAIL_FROM=you@example.com
EMAIL_TO=you@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password-here

# --- newsletters in (optional, IMAP, read-only) ---
IMAP_HOST=imap.example.com
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=Newsletters

# --- local embeddings (optional) ---
OLLAMA_URL=http://127.0.0.1:11434

# --- macOS scheduling ---
KB_LAUNCHD_PREFIX=com.example.kbase
